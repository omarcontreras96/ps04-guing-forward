  "events": [ {
    "tStartMs": 15004,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So this"
    } ]
  }, {
    "tStartMs": 16084,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "is not...\nan iPhone Duo..."
    } ]
  }, {
    "tStartMs": 17793,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "This is the Xiaomi 18...\nFold."
    } ]
  }, {
    "tStartMs": 19775,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "What you're looking at is a\nfolding phone with the exact same"
    } ]
  }, {
    "tStartMs": 23945,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "dimensions as the iPhone Duo,"
    } ]
  }, {
    "tStartMs": 25927,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "the exact same aspect ratio\nfor the inside screen and,"
    } ]
  }, {
    "tStartMs": 29739,
    "dDurationMs": 1491,
    "segs": [ {
      "utf8": "and the outside screen."
    } ]
  }, {
    "tStartMs": 31312,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "It has a lot of the same\nfeatures as the iPhone Duo,"
    } ]
  }, {
    "tStartMs": 34834,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "including this D-shaped display,"
    } ]
  }, {
    "tStartMs": 37562,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "but..."
    } ]
  }, {
    "tStartMs": 38474,
    "dDurationMs": 2935,
    "segs": [ {
      "utf8": "it has also one-upped it\nin several really key ways."
    } ]
  }, {
    "tStartMs": 41491,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "I just want to start by answering\na question that a lot of people get"
    } ]
  }, {
    "tStartMs": 44158,
    "dDurationMs": 1695,
    "segs": [ {
      "utf8": "wrong on the Internet right now,\nwhich is just,"
    } ]
  }, {
    "tStartMs": 46575,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "how does this happen?"
    } ]
  }, {
    "tStartMs": 47487,
    "dDurationMs": 4156,
    "segs": [ {
      "utf8": "How do we have the iPhone Duo\ngetting unveiled on September 9,"
    } ]
  }, {
    "tStartMs": 51725,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "2026,"
    } ]
  }, {
    "tStartMs": 52769,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "but this Xiaomi Fold was officially\nunveiled two days earlier,"
    } ]
  }, {
    "tStartMs": 56532,
    "dDurationMs": 1785,
    "segs": [ {
      "utf8": "on September 6, 7th,\n2026?"
    } ]
  }, {
    "tStartMs": 58399,
    "dDurationMs": 1432,
    "segs": [ {
      "utf8": "There are people saying, \"Wow,"
    } ]
  }, {
    "tStartMs": 59913,
    "dDurationMs": 3805,
    "segs": [ {
      "utf8": "Apple actually copied Xiaomi.\" But then\na whole bunch of other people saying,"
    } ]
  }, {
    "tStartMs": 63800,
    "dDurationMs": 1988,
    "segs": [ {
      "utf8": "\"No, no,\nno, Xiaomi did still copy Apple,"
    } ]
  }, {
    "tStartMs": 65870,
    "dDurationMs": 1483,
    "segs": [ {
      "utf8": "even though it came out first.\""
    } ]
  }, {
    "tStartMs": 67555,
    "dDurationMs": 3553,
    "segs": [ {
      "utf8": "But we also know that the development\ncycle of these tech products is..."
    } ]
  }, {
    "tStartMs": 71190,
    "dDurationMs": 1129,
    "segs": [ {
      "utf8": "many, many, many months,"
    } ]
  }, {
    "tStartMs": 72521,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "usually years."
    } ]
  }, {
    "tStartMs": 73868,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "And yet..."
    } ]
  }, {
    "tStartMs": 74780,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "somehow these phones got unveiled\ntwo days from each other."
    } ]
  }, {
    "tStartMs": 77431,
    "dDurationMs": 885,
    "segs": [ {
      "utf8": "So here's the deal."
    } ]
  }, {
    "tStartMs": 78398,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "We know that these tech\ncompanies are very,"
    } ]
  }, {
    "tStartMs": 80585,
    "dDurationMs": 1495,
    "segs": [ {
      "utf8": "very competitive...\nThey're also"
    } ]
  }, {
    "tStartMs": 82282,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "very,"
    } ]
  }, {
    "tStartMs": 83326,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "very, very secretive."
    } ]
  }, {
    "tStartMs": 84238,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "So a company like Apple,\nif they can help it,"
    } ]
  }, {
    "tStartMs": 85943,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "is going to try to develop their\nnew products in complete secrecy"
    } ]
  }, {
    "tStartMs": 89267,
    "dDurationMs": 1003,
    "segs": [ {
      "utf8": "as long as possible..."
    } ]
  }, {
    "tStartMs": 90352,
    "dDurationMs": 1791,
    "segs": [ {
      "utf8": "so they can surprise people at launch."
    } ]
  }, {
    "tStartMs": 92345,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So, of course,"
    } ]
  }, {
    "tStartMs": 93257,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "they've been watching the\nfoldables market and they"
    } ]
  }, {
    "tStartMs": 95549,
    "dDurationMs": 1496,
    "segs": [ {
      "utf8": "finally have decided to jump in."
    } ]
  }, {
    "tStartMs": 97127,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "And so they start developing and\nworking on their folding iPhone."
    } ]
  }, {
    "tStartMs": 100375,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "They will have these very strict rules\nfor people working on these really,"
    } ]
  }, {
    "tStartMs": 103699,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "really secretive,"
    } ]
  }, {
    "tStartMs": 104611,
    "dDurationMs": 2465,
    "segs": [ {
      "utf8": "unannounced products just to\ntry to keep things from leaking"
    } ]
  }, {
    "tStartMs": 107558,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "to the point where, like,"
    } ]
  }, {
    "tStartMs": 108801,
    "dDurationMs": 3511,
    "segs": [ {
      "utf8": "engineers go home at the end of the day\nand they can't tell their families about"
    } ]
  }, {
    "tStartMs": 112394,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "the thing they worked on at work that day."
    } ]
  }, {
    "tStartMs": 114288,
    "dDurationMs": 3268,
    "segs": [ {
      "utf8": "So things can actually stay pretty\ncontained within Apple's walls."
    } ]
  }, {
    "tStartMs": 117638,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "But eventually they have to\ngo out and make the thing..."
    } ]
  }, {
    "tStartMs": 120481,
    "dDurationMs": 3979,
    "segs": [ {
      "utf8": "And so they have to go out and have those\nconversations with parts suppliers and"
    } ]
  }, {
    "tStartMs": 124542,
    "dDurationMs": 3472,
    "segs": [ {
      "utf8": "factories and start probing and having\nthose conversations and placing"
    } ]
  }, {
    "tStartMs": 128096,
    "dDurationMs": 3065,
    "segs": [ {
      "utf8": "orders of parts to actually make\nthe thing that they designed."
    } ]
  }, {
    "tStartMs": 131723,
    "dDurationMs": 1187,
    "segs": [ {
      "utf8": "And those other companies"
    } ]
  }, {
    "tStartMs": 133712,
    "dDurationMs": 1848,
    "segs": [ {
      "utf8": "are not...\nquite as secretive as Apple."
    } ]
  }, {
    "tStartMs": 135642,
    "dDurationMs": 1385,
    "segs": [ {
      "utf8": "So that's where information"
    } ]
  }, {
    "tStartMs": 137509,
    "dDurationMs": 2688,
    "segs": [ {
      "utf8": "starts to leak.\nAnd people start to find out that..."
    } ]
  }, {
    "tStartMs": 140279,
    "dDurationMs": 2579,
    "segs": [ {
      "utf8": "Apple needs a bunch of\nfolding OLEDs of this size"
    } ]
  }, {
    "tStartMs": 143060,
    "dDurationMs": 4319,
    "segs": [ {
      "utf8": "and a hinge that works in this exact way\nand a chassis of these exact dimensions."
    } ]
  }, {
    "tStartMs": 147461,
    "dDurationMs": 2672,
    "segs": [ {
      "utf8": "So that's how you end up with the\nnew mockups and stuff with the"
    } ]
  }, {
    "tStartMs": 150215,
    "dDurationMs": 1424,
    "segs": [ {
      "utf8": "exact dimensions of the new iPhone."
    } ]
  }, {
    "tStartMs": 151841,
    "dDurationMs": 1166,
    "segs": [ {
      "utf8": "Now, software stuff, notably,"
    } ]
  }, {
    "tStartMs": 153209,
    "dDurationMs": 2714,
    "segs": [ {
      "utf8": "doesn't leak nearly as much because\nit doesn't have to go through"
    } ]
  }, {
    "tStartMs": 156005,
    "dDurationMs": 1074,
    "segs": [ {
      "utf8": "that entire supply chain."
    } ]
  }, {
    "tStartMs": 157161,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "And so they're actually typically\nable to surprise us a little bit"
    } ]
  }, {
    "tStartMs": 160309,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "more with the software features.\nBut yeah,"
    } ]
  }, {
    "tStartMs": 162313,
    "dDurationMs": 4155,
    "segs": [ {
      "utf8": "now it's months before the release of the\nnext iPhone and companies like Xiaomi,"
    } ]
  }, {
    "tStartMs": 166670,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "you know,"
    } ]
  }, {
    "tStartMs": 167582,
    "dDurationMs": 3455,
    "segs": [ {
      "utf8": "they don't have a CAD render of the\nexact new iPhone that's gonna come out,"
    } ]
  }, {
    "tStartMs": 171119,
    "dDurationMs": 1137,
    "segs": [ {
      "utf8": "but they do have enough"
    } ]
  }, {
    "tStartMs": 173138,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "to make..."
    } ]
  }, {
    "tStartMs": 174050,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "their own version of the thing\nand they have the advantage"
    } ]
  }, {
    "tStartMs": 176859,
    "dDurationMs": 3679,
    "segs": [ {
      "utf8": "of speed so they can go into overdrive\nand commit to putting this thing"
    } ]
  }, {
    "tStartMs": 180620,
    "dDurationMs": 1348,
    "segs": [ {
      "utf8": "together and putting it out"
    } ]
  }, {
    "tStartMs": 182170,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "before the predictable\nApple event timing..."
    } ]
  }, {
    "tStartMs": 184501,
    "dDurationMs": 2778,
    "segs": [ {
      "utf8": "And there's lots of examples\nof this happening before."
    } ]
  }, {
    "tStartMs": 187361,
    "dDurationMs": 1594,
    "segs": [ {
      "utf8": "You might remember last year,"
    } ]
  }, {
    "tStartMs": 189037,
    "dDurationMs": 3502,
    "segs": [ {
      "utf8": "literally months before the\niPhone Air September announcement,"
    } ]
  }, {
    "tStartMs": 192621,
    "dDurationMs": 3906,
    "segs": [ {
      "utf8": "we got a teaser of this ultra-thin\nphone that Samsung's working on..."
    } ]
  }, {
    "tStartMs": 196609,
    "dDurationMs": 2057,
    "segs": [ {
      "utf8": "that turned out to be the S25 Edge..."
    } ]
  }, {
    "tStartMs": 198748,
    "dDurationMs": 1074,
    "segs": [ {
      "utf8": "that came out first."
    } ]
  }, {
    "tStartMs": 200464,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Same idea."
    } ]
  }, {
    "tStartMs": 201508,
    "dDurationMs": 2347,
    "segs": [ {
      "utf8": "And Xiaomi, as we know,\nis not exactly shy about"
    } ]
  }, {
    "tStartMs": 204417,
    "dDurationMs": 2924,
    "segs": [ {
      "utf8": "borrowing...\nApple's aesthetic in an effort to try to"
    } ]
  }, {
    "tStartMs": 207543,
    "dDurationMs": 1825,
    "segs": [ {
      "utf8": "borrow...\nsome of their customers."
    } ]
  }, {
    "tStartMs": 209450,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "So yeah,\nthis shouldn't exactly be a shock to us."
    } ]
  }, {
    "tStartMs": 212213,
    "dDurationMs": 1215,
    "segs": [ {
      "utf8": "A folding phone that is"
    } ]
  }, {
    "tStartMs": 213990,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "to the millimeter,"
    } ]
  }, {
    "tStartMs": 215485,
    "dDurationMs": 1779,
    "segs": [ {
      "utf8": "the exact same...\nheight and width"
    } ]
  }, {
    "tStartMs": 217466,
    "dDurationMs": 1102,
    "segs": [ {
      "utf8": "and same aspect ratio"
    } ]
  }, {
    "tStartMs": 219380,
    "dDurationMs": 1328,
    "segs": [ {
      "utf8": "as Apple's folding phone."
    } ]
  }, {
    "tStartMs": 221430,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "But then they actually went out\nand one-upped the iPhone Duo"
    } ]
  }, {
    "tStartMs": 224814,
    "dDurationMs": 1271,
    "segs": [ {
      "utf8": "in a couple of ways too."
    } ]
  }, {
    "tStartMs": 226167,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So if you remember my first\nimpressions of the iPhone Duo,"
    } ]
  }, {
    "tStartMs": 229309,
    "dDurationMs": 3494,
    "segs": [ {
      "utf8": "the passport size is nice,\nthe shape is actually really reachable."
    } ]
  }, {
    "tStartMs": 233005,
    "dDurationMs": 1327,
    "segs": [ {
      "utf8": "But that is a heavy phone."
    } ]
  }, {
    "tStartMs": 234414,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "It's actually the heaviest\niPhone of all time,"
    } ]
  }, {
    "tStartMs": 236906,
    "dDurationMs": 1314,
    "segs": [ {
      "utf8": "clocking in at 254 grams."
    } ]
  }, {
    "tStartMs": 238380,
    "dDurationMs": 1638,
    "segs": [ {
      "utf8": "And you know, it feels substantial."
    } ]
  }, {
    "tStartMs": 240100,
    "dDurationMs": 3946,
    "segs": [ {
      "utf8": "And I think a lot of people I'm sure will\nassociate that weight with high quality..."
    } ]
  }, {
    "tStartMs": 244128,
    "dDurationMs": 2796,
    "segs": [ {
      "utf8": "But what a lot of us foldables\npeople end up liking more is,"
    } ]
  }, {
    "tStartMs": 247126,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "is a lighter object to hold,\njust less fatiguing."
    } ]
  }, {
    "tStartMs": 249511,
    "dDurationMs": 2644,
    "segs": [ {
      "utf8": "And this Xiaomi Fold is\na whole 30 grams lighter,"
    } ]
  }, {
    "tStartMs": 252237,
    "dDurationMs": 2977,
    "segs": [ {
      "utf8": "much closer to the weight of\na normal large slab phone."
    } ]
  }, {
    "tStartMs": 255296,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "And that makes a huge difference."
    } ]
  }, {
    "tStartMs": 257252,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "And they've managed to do this with a\n6,000 mAh silicon-carbon battery that"
    } ]
  }, {
    "tStartMs": 261424,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "also supports 67-watt fast charging\nand 50-watt wireless charging"
    } ]
  }, {
    "tStartMs": 265040,
    "dDurationMs": 1352,
    "segs": [ {
      "utf8": "with the right accessory."
    } ]
  }, {
    "tStartMs": 266474,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "We don't know the exact battery\nsize of the iPhone Duo yet,"
    } ]
  }, {
    "tStartMs": 269306,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "but if I was guessing,\nand this is before the..."
    } ]
  }, {
    "tStartMs": 271609,
    "dDurationMs": 3278,
    "segs": [ {
      "utf8": "reviews that are of course coming soon,\nso get subscribed to see that."
    } ]
  }, {
    "tStartMs": 274969,
    "dDurationMs": 1111,
    "segs": [ {
      "utf8": "But if I was guessing..."
    } ]
  }, {
    "tStartMs": 276960,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "The battery might be"
    } ]
  }, {
    "tStartMs": 278455,
    "dDurationMs": 3653,
    "segs": [ {
      "utf8": "either the weakest or second\nweakest part of that phone."
    } ]
  }, {
    "tStartMs": 282190,
    "dDurationMs": 3612,
    "segs": [ {
      "utf8": "Apple's famously pretty conservative\nwith the physical battery capacity."
    } ]
  }, {
    "tStartMs": 286004,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "They're not doing silicon-carbon and\nthey're not doing super-fast charging."
    } ]
  }, {
    "tStartMs": 289852,
    "dDurationMs": 3458,
    "segs": [ {
      "utf8": "And so people are estimating the Duo's\nbattery to be somewhere around"
    } ]
  }, {
    "tStartMs": 293392,
    "dDurationMs": 3047,
    "segs": [ {
      "utf8": "that 5,000 milliamp-hour mark\ncombined between the two sides."
    } ]
  }, {
    "tStartMs": 296641,
    "dDurationMs": 2278,
    "segs": [ {
      "utf8": "That is smaller than the\n18 Pro Max's battery."
    } ]
  }, {
    "tStartMs": 299001,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "And we know the A20 Pro\nis great and everything,"
    } ]
  }, {
    "tStartMs": 301286,
    "dDurationMs": 1204,
    "segs": [ {
      "utf8": "but there is also a massive"
    } ]
  }, {
    "tStartMs": 302692,
    "dDurationMs": 1489,
    "segs": [ {
      "utf8": "7-and-a-half-inch screen to power"
    } ]
  }, {
    "tStartMs": 304383,
    "dDurationMs": 2394,
    "segs": [ {
      "utf8": "when it's open.\nThe Z Fold 8 has the same limitation."
    } ]
  }, {
    "tStartMs": 306859,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It has a 4,800 milliamp-hour battery."
    } ]
  }, {
    "tStartMs": 308621,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "And if you use it with that\nscreen open for long enough,"
    } ]
  }, {
    "tStartMs": 311070,
    "dDurationMs": 2717,
    "segs": [ {
      "utf8": "it just drinks battery quite a\nbit faster than when it's closed."
    } ]
  }, {
    "tStartMs": 313869,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "Xiaomi has never been shy\nabout the super-high-capacity"
    } ]
  }, {
    "tStartMs": 316275,
    "dDurationMs": 1011,
    "segs": [ {
      "utf8": "silicon-carbon batteries."
    } ]
  }, {
    "tStartMs": 317368,
    "dDurationMs": 2411,
    "segs": [ {
      "utf8": "And I think a folding phone\nis the right place to put it."
    } ]
  }, {
    "tStartMs": 319861,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "It's thinner, there's less volume,"
    } ]
  }, {
    "tStartMs": 321444,
    "dDurationMs": 2617,
    "segs": [ {
      "utf8": "you're kind of splitting it\nup with a hinge in the middle."
    } ]
  }, {
    "tStartMs": 324263,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "But you have a huge screen..."
    } ]
  }, {
    "tStartMs": 325613,
    "dDurationMs": 1873,
    "segs": [ {
      "utf8": "so you want it to be able to last all day."
    } ]
  }, {
    "tStartMs": 327568,
    "dDurationMs": 1826,
    "segs": [ {
      "utf8": "And putting 6,000 milliamp-hours in there"
    } ]
  }, {
    "tStartMs": 330126,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "goes a long way."
    } ]
  }, {
    "tStartMs": 331038,
    "dDurationMs": 2579,
    "segs": [ {
      "utf8": "But then the other thing you've\nprobably noticed by now..."
    } ]
  }, {
    "tStartMs": 333699,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "is those cameras."
    } ]
  }, {
    "tStartMs": 334611,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "So in case you forgot with all the hype,\nthe iPhone Duo has two cameras."
    } ]
  }, {
    "tStartMs": 338860,
    "dDurationMs": 1912,
    "segs": [ {
      "utf8": "It's a primary and an ultra-wide."
    } ]
  }, {
    "tStartMs": 340854,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "There is no zoom camera."
    } ]
  }, {
    "tStartMs": 342304,
    "dDurationMs": 4691,
    "segs": [ {
      "utf8": "The Xiaomi Fold back here has a camera\nbar with triple cameras around the back."
    } ]
  }, {
    "tStartMs": 347077,
    "dDurationMs": 1973,
    "segs": [ {
      "utf8": "There's a 200-megapixel primary..."
    } ]
  }, {
    "tStartMs": 349132,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "and it has an ultra-wide"
    } ]
  }, {
    "tStartMs": 350702,
    "dDurationMs": 1308,
    "segs": [ {
      "utf8": "and a 50-megapixel 3.5x"
    } ]
  }, {
    "tStartMs": 352212,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "zoom camera as well."
    } ]
  }, {
    "tStartMs": 353421,
    "dDurationMs": 3268,
    "segs": [ {
      "utf8": "Now we already know these foldables\ndon't have the most Z-depth..."
    } ]
  }, {
    "tStartMs": 356771,
    "dDurationMs": 3116,
    "segs": [ {
      "utf8": "They're ultra-thin because they're\nsplit in half on both sides."
    } ]
  }, {
    "tStartMs": 359969,
    "dDurationMs": 2507,
    "segs": [ {
      "utf8": "So that's why there's no\nFace ID on the iPhone Duo."
    } ]
  }, {
    "tStartMs": 362558,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "Not enough room for it."
    } ]
  }, {
    "tStartMs": 364205,
    "dDurationMs": 3218,
    "segs": [ {
      "utf8": "And so there also is always that\nchallenge of not having a lot of"
    } ]
  }, {
    "tStartMs": 367505,
    "dDurationMs": 1491,
    "segs": [ {
      "utf8": "room for actual flagship-sized,"
    } ]
  }, {
    "tStartMs": 369078,
    "dDurationMs": 984,
    "segs": [ {
      "utf8": "large camera sensors."
    } ]
  }, {
    "tStartMs": 370144,
    "dDurationMs": 2807,
    "segs": [ {
      "utf8": "But it does feel like\nXiaomi still found a way..."
    } ]
  }, {
    "tStartMs": 373033,
    "dDurationMs": 2276,
    "segs": [ {
      "utf8": "to one-up the iPhone, at least on paper."
    } ]
  }, {
    "tStartMs": 376111,
    "dDurationMs": 3868,
    "segs": [ {
      "utf8": "I think our best guess for the\niPhone Duo's camera is it's probably"
    } ]
  }, {
    "tStartMs": 380061,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "the iPhone 17E's main camera.\nYou know,"
    } ]
  }, {
    "tStartMs": 382308,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "the descriptions on Apple's\nsite are exactly the same for"
    } ]
  }, {
    "tStartMs": 385830,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "48 megapixels"
    } ]
  }, {
    "tStartMs": 386874,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Hybrid Focus Pixels...\nThat sensor"
    } ]
  }, {
    "tStartMs": 388816,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "is much smaller than\nthe one Xiaomi is using."
    } ]
  }, {
    "tStartMs": 391502,
    "dDurationMs": 4454,
    "segs": [ {
      "utf8": "It's a 1/2.55-inch sensor and Xiaomi\nhas a 200-megapixel 1/1.56-inch sensor."
    } ]
  }, {
    "tStartMs": 396038,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So you know,"
    } ]
  }, {
    "tStartMs": 396950,
    "dDurationMs": 3781,
    "segs": [ {
      "utf8": "TBD on how well the iPhone Duo's\ncamera actually performs and if the"
    } ]
  }, {
    "tStartMs": 400813,
    "dDurationMs": 4037,
    "segs": [ {
      "utf8": "A20 Pro's image signal processor can\nsqueeze anything more out of it."
    } ]
  }, {
    "tStartMs": 404932,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "But you know,"
    } ]
  }, {
    "tStartMs": 405844,
    "dDurationMs": 2892,
    "segs": [ {
      "utf8": "you can at least guaranteed give Xiaomi\nthe win in the zoom department..."
    } ]
  }, {
    "tStartMs": 408818,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "for having a dedicated zoom camera."
    } ]
  }, {
    "tStartMs": 410400,
    "dDurationMs": 2132,
    "segs": [ {
      "utf8": "And I'll also throw in\nthat I find this pretty..."
    } ]
  }, {
    "tStartMs": 412614,
    "dDurationMs": 3126,
    "segs": [ {
      "utf8": "this little camera bar is kind of\nnice to hold when I'm using the phone"
    } ]
  }, {
    "tStartMs": 415942,
    "dDurationMs": 2038,
    "segs": [ {
      "utf8": "in portrait.\nIt's kind of like a little handle."
    } ]
  }, {
    "tStartMs": 418820,
    "dDurationMs": 2693,
    "segs": [ {
      "utf8": "Probably smudging this a lot also, but...\nit's nice."
    } ]
  }, {
    "tStartMs": 421595,
    "dDurationMs": 926,
    "segs": [ {
      "utf8": "On the inside screen,"
    } ]
  }, {
    "tStartMs": 422603,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "you probably remember the\niPhone hid their selfie camera"
    } ]
  }, {
    "tStartMs": 425289,
    "dDurationMs": 1022,
    "segs": [ {
      "utf8": "underneath the display."
    } ]
  }, {
    "tStartMs": 426393,
    "dDurationMs": 3324,
    "segs": [ {
      "utf8": "Xiaomi just went ahead with a standard\nhole-punch cutout in the corner,"
    } ]
  }, {
    "tStartMs": 429799,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "which, I mean,"
    } ]
  }, {
    "tStartMs": 430711,
    "dDurationMs": 1885,
    "segs": [ {
      "utf8": "that's gonna win by\ndefault for image quality."
    } ]
  }, {
    "tStartMs": 432678,
    "dDurationMs": 2412,
    "segs": [ {
      "utf8": "I don't really mind it in\nthe corner up here either."
    } ]
  }, {
    "tStartMs": 435172,
    "dDurationMs": 878,
    "segs": [ {
      "utf8": "It's out of the way."
    } ]
  }, {
    "tStartMs": 436132,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Obviously the big dramatic uninterrupted\nsurface with no crease and no cutouts"
    } ]
  }, {
    "tStartMs": 440314,
    "dDurationMs": 1645,
    "segs": [ {
      "utf8": "is cool and it resembles the iPad..."
    } ]
  }, {
    "tStartMs": 442041,
    "dDurationMs": 2029,
    "segs": [ {
      "utf8": "But yeah,\nthere's a cutout here with Xiaomi."
    } ]
  }, {
    "tStartMs": 444152,
    "dDurationMs": 2077,
    "segs": [ {
      "utf8": "Now the Xiaomi does have\na bit more crease..."
    } ]
  }, {
    "tStartMs": 446311,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "here.\nIt's not terrible,"
    } ]
  }, {
    "tStartMs": 447943,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "but there is no anti-glare finish\nand it can sometimes catch"
    } ]
  }, {
    "tStartMs": 451251,
    "dDurationMs": 1296,
    "segs": [ {
      "utf8": "your eye once in a while."
    } ]
  }, {
    "tStartMs": 452629,
    "dDurationMs": 1903,
    "segs": [ {
      "utf8": "But it's definitely not problematic."
    } ]
  }, {
    "tStartMs": 454614,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "Like if the Duo..."
    } ]
  }, {
    "tStartMs": 455606,
    "dDurationMs": 2785,
    "segs": [ {
      "utf8": "and the Find N6 are 9 out\nof 10 for a crease delete,"
    } ]
  }, {
    "tStartMs": 458473,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "this is at a 7."
    } ]
  }, {
    "tStartMs": 459385,
    "dDurationMs": 2432,
    "segs": [ {
      "utf8": "But there's also one more big\ndifference between these phones,"
    } ]
  }, {
    "tStartMs": 461899,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "which is that thing that doesn't\nreally leak nearly as much,"
    } ]
  }, {
    "tStartMs": 464535,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "which is"
    } ]
  }, {
    "tStartMs": 465579,
    "dDurationMs": 849,
    "segs": [ {
      "utf8": "that software.\nYou know,"
    } ]
  }, {
    "tStartMs": 466510,
    "dDurationMs": 3485,
    "segs": [ {
      "utf8": "that's why things like that opening\nand closing glassy animation"
    } ]
  }, {
    "tStartMs": 470077,
    "dDurationMs": 1088,
    "segs": [ {
      "utf8": "that Apple pulled off"
    } ]
  }, {
    "tStartMs": 471367,
    "dDurationMs": 2092,
    "segs": [ {
      "utf8": "actually took us all by surprise and..."
    } ]
  }, {
    "tStartMs": 473541,
    "dDurationMs": 3987,
    "segs": [ {
      "utf8": "makes us feel a really big difference\nin how responsive and nice it feels"
    } ]
  }, {
    "tStartMs": 477730,
    "dDurationMs": 1089,
    "segs": [ {
      "utf8": "to use an iPhone Duo."
    } ]
  }, {
    "tStartMs": 478901,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "Now Android folding phones have\nalso had these screen opening and"
    } ]
  }, {
    "tStartMs": 481867,
    "dDurationMs": 1515,
    "segs": [ {
      "utf8": "closing animations for a while now,"
    } ]
  }, {
    "tStartMs": 483944,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "but there are some differences."
    } ]
  }, {
    "tStartMs": 485359,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "First of all, when you close..."
    } ]
  }, {
    "tStartMs": 486899,
    "dDurationMs": 1707,
    "segs": [ {
      "utf8": "basically any Android folding phone,"
    } ]
  }, {
    "tStartMs": 488688,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "the default behavior is to just\nassume that you're done with"
    } ]
  }, {
    "tStartMs": 491669,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "it and you're shutting it."
    } ]
  }, {
    "tStartMs": 493421,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "And if you want to continue,\nthen you have to act."
    } ]
  }, {
    "tStartMs": 495906,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "You have to either swipe or\nwake up the outside display."
    } ]
  }, {
    "tStartMs": 499168,
    "dDurationMs": 2005,
    "segs": [ {
      "utf8": "And I've been using foldables for a while."
    } ]
  }, {
    "tStartMs": 501255,
    "dDurationMs": 1955,
    "segs": [ {
      "utf8": "I've really gotten used to that behavior."
    } ]
  }, {
    "tStartMs": 503292,
    "dDurationMs": 1309,
    "segs": [ {
      "utf8": "The iPhone does not do that."
    } ]
  }, {
    "tStartMs": 504683,
    "dDurationMs": 3645,
    "segs": [ {
      "utf8": "As soon as you're halfway done closing it,\nit lights up the outside display"
    } ]
  }, {
    "tStartMs": 508530,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "to maintain this sort of fluid\ncontinuity with the animation."
    } ]
  }, {
    "tStartMs": 511920,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "And I don't hate that."
    } ]
  }, {
    "tStartMs": 512920,
    "dDurationMs": 3728,
    "segs": [ {
      "utf8": "But I want to point out two things\nthat the Android foldable software has"
    } ]
  }, {
    "tStartMs": 517450,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "that..."
    } ]
  }, {
    "tStartMs": 518362,
    "dDurationMs": 2451,
    "segs": [ {
      "utf8": "I'm just wondering when the\niPhone Duo will eventually add."
    } ]
  }, {
    "tStartMs": 520895,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So number one,"
    } ]
  }, {
    "tStartMs": 522389,
    "dDurationMs": 1276,
    "segs": [ {
      "utf8": "more windows at once.\nLike,"
    } ]
  }, {
    "tStartMs": 523747,
    "dDurationMs": 2350,
    "segs": [ {
      "utf8": "these are gonna be\nmultitasking machines..."
    } ]
  }, {
    "tStartMs": 526179,
    "dDurationMs": 3368,
    "segs": [ {
      "utf8": "iPhone Duo famously only lets\nyou do two apps side by side..."
    } ]
  }, {
    "tStartMs": 529629,
    "dDurationMs": 1849,
    "segs": [ {
      "utf8": "And that's it.\nThe Android world is"
    } ]
  }, {
    "tStartMs": 532040,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "full"
    } ]
  }, {
    "tStartMs": 533084,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "of multi-window, bubble window,\noverlay, triple-app multitasking,"
    } ]
  }, {
    "tStartMs": 536088,
    "dDurationMs": 4074,
    "segs": [ {
      "utf8": "all sorts of crazy stuff everywhere,\nas if you have a full-size tablet..."
    } ]
  }, {
    "tStartMs": 540244,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "and, you know,\ntwo screens side by side is not bad,"
    } ]
  }, {
    "tStartMs": 543148,
    "dDurationMs": 2423,
    "segs": [ {
      "utf8": "but maybe there'll be\na third at some point."
    } ]
  }, {
    "tStartMs": 545653,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "But then, two."
    } ]
  }, {
    "tStartMs": 546663,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "So this is something..."
    } ]
  }, {
    "tStartMs": 548125,
    "dDurationMs": 1888,
    "segs": [ {
      "utf8": "MrMobile brought up a few times"
    } ]
  }, {
    "tStartMs": 550805,
    "dDurationMs": 935,
    "segs": [ {
      "utf8": "with these folds"
    } ]
  }, {
    "tStartMs": 551942,
    "dDurationMs": 3414,
    "segs": [ {
      "utf8": "is the camera.\nSo when you're taking a photo of yourself"
    } ]
  }, {
    "tStartMs": 555558,
    "dDurationMs": 1612,
    "segs": [ {
      "utf8": "using the primary cameras,"
    } ]
  }, {
    "tStartMs": 558050,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "that back screen."
    } ]
  }, {
    "tStartMs": 558999,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "these phones all specifically disable..."
    } ]
  }, {
    "tStartMs": 560932,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "the back screen to prevent\naccidental touches."
    } ]
  }, {
    "tStartMs": 563154,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "It's very clever."
    } ]
  }, {
    "tStartMs": 564066,
    "dDurationMs": 2864,
    "segs": [ {
      "utf8": "They've all kind of realized\nthat this is a smart thing to do."
    } ]
  }, {
    "tStartMs": 567170,
    "dDurationMs": 2424,
    "segs": [ {
      "utf8": "The iPhone Duo actually\ndoesn't seem to do this..."
    } ]
  }, {
    "tStartMs": 569676,
    "dDurationMs": 2975,
    "segs": [ {
      "utf8": "And it would kind of shock me if\nthey didn't realize sooner or"
    } ]
  }, {
    "tStartMs": 572733,
    "dDurationMs": 1446,
    "segs": [ {
      "utf8": "later that they should do this."
    } ]
  }, {
    "tStartMs": 574381,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "But we haven't seen that yet."
    } ]
  }, {
    "tStartMs": 575816,
    "dDurationMs": 2074,
    "segs": [ {
      "utf8": "That is definitely something\nI'll be keeping an eye on."
    } ]
  }, {
    "tStartMs": 578540,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "Also, I am excited to finally announce..."
    } ]
  }, {
    "tStartMs": 581261,
    "dDurationMs": 1225,
    "segs": [ {
      "utf8": "that the desk pad..."
    } ]
  }, {
    "tStartMs": 582568,
    "dDurationMs": 899,
    "segs": [ {
      "utf8": "that we've made"
    } ]
  }, {
    "tStartMs": 584029,
    "dDurationMs": 1749,
    "segs": [ {
      "utf8": "is finally actually on sale."
    } ]
  }, {
    "tStartMs": 585860,
    "dDurationMs": 2852,
    "segs": [ {
      "utf8": "We collaborated with Omnitype,\nso if you know, you know."
    } ]
  }, {
    "tStartMs": 588794,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "And we designed this brand new desk pad"
    } ]
  }, {
    "tStartMs": 590957,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "and I think it's awesome.\nIt's large,"
    } ]
  }, {
    "tStartMs": 592962,
    "dDurationMs": 1228,
    "segs": [ {
      "utf8": "it's 4 millimeters thick."
    } ]
  }, {
    "tStartMs": 594272,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It has this nice stitching around\nthe edges and rubber at the bottom"
    } ]
  }, {
    "tStartMs": 597834,
    "dDurationMs": 1465,
    "segs": [ {
      "utf8": "to keep it soundly in place."
    } ]
  }, {
    "tStartMs": 599381,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And there's actually two\nversions of this on the site."
    } ]
  }, {
    "tStartMs": 602263,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "For those of you who really know ball,"
    } ]
  }, {
    "tStartMs": 604412,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "there's smooth"
    } ]
  }, {
    "tStartMs": 605456,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "and rough.\nSmooth will feel like a normal mousepad."
    } ]
  }, {
    "tStartMs": 607790,
    "dDurationMs": 1945,
    "segs": [ {
      "utf8": "Rough is...\nhas a little texture to it for"
    } ]
  }, {
    "tStartMs": 609937,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "more precise movements,\nif you're into that."
    } ]
  }, {
    "tStartMs": 612112,
    "dDurationMs": 2686,
    "segs": [ {
      "utf8": "I think if you just want\nsomething you're familiar with,"
    } ]
  }, {
    "tStartMs": 614880,
    "dDurationMs": 1549,
    "segs": [ {
      "utf8": "smooth is probably the way to go."
    } ]
  }, {
    "tStartMs": 616511,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "But I really like the rough."
    } ]
  }, {
    "tStartMs": 617895,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "All the mouse pads I\nuse have that texture."
    } ]
  }, {
    "tStartMs": 620021,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 621065,
    "dDurationMs": 1416,
    "segs": [ {
      "utf8": "if, you know,\nif you want that, you can get it."
    } ]
  }, {
    "tStartMs": 622563,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "But yeah,"
    } ]
  }, {
    "tStartMs": 623475,
    "dDurationMs": 1394,
    "segs": [ {
      "utf8": "we're very happy to\nfinally be launching this."
    } ]
  }, {
    "tStartMs": 624951,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "It's...\nIt's on the site on mkbhd.com"
    } ]
  }, {
    "tStartMs": 626633,
    "dDurationMs": 2697,
    "segs": [ {
      "utf8": "you can get one starting literally today,\nwhich is super sick..."
    } ]
  }, {
    "tStartMs": 629412,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Let me know."
    } ]
  }, {
    "tStartMs": 630324,
    "dDurationMs": 1610,
    "segs": [ {
