      "utf8": "Also,"
    } ]
  }, {
    "tStartMs": 689936,
    "dDurationMs": 2987,
    "segs": [ {
      "utf8": "in case you're curious which Googlebook\nhas the best speakers for watching movies,"
    } ]
  }, {
    "tStartMs": 693005,
    "dDurationMs": 1515,
    "segs": [ {
      "utf8": "because we do that in college too,"
    } ]
  }, {
    "tStartMs": 695480,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "it's the ASUS."
    } ]
  }, {
    "tStartMs": 697200,
    "dDurationMs": 927,
    "segs": [ {
      "utf8": "Okay, next: Writers."
    } ]
  }, {
    "tStartMs": 698719,
    "dDurationMs": 3112,
    "segs": [ {
      "utf8": "I consider myself a bit of a\npart-time writer with these videos..."
    } ]
  }, {
    "tStartMs": 701913,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "It's pretty good for that."
    } ]
  }, {
    "tStartMs": 703177,
    "dDurationMs": 1892,
    "segs": [ {
      "utf8": "I wrote a lot of this review\non the ASUS Googlebook."
    } ]
  }, {
    "tStartMs": 705151,
    "dDurationMs": 943,
    "segs": [ {
      "utf8": "The keyboard's pretty good."
    } ]
  }, {
    "tStartMs": 706176,
    "dDurationMs": 1056,
    "segs": [ {
      "utf8": "The battery life is very good."
    } ]
  }, {
    "tStartMs": 707314,
    "dDurationMs": 2488,
    "segs": [ {
      "utf8": "The screen is more than enough.\nIt's all been fine."
    } ]
  }, {
    "tStartMs": 709884,
    "dDurationMs": 894,
    "segs": [ {
      "utf8": "I mean, word processing,"
    } ]
  }, {
    "tStartMs": 711290,
    "dDurationMs": 853,
    "segs": [ {
      "utf8": "web browsing, emailing,"
    } ]
  }, {
    "tStartMs": 712835,
    "dDurationMs": 1138,
    "segs": [ {
      "utf8": "it's all right up their alley."
    } ]
  }, {
    "tStartMs": 714055,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "And then there's the Google stuff on top."
    } ]
  }, {
    "tStartMs": 715800,
    "dDurationMs": 3887,
    "segs": [ {
      "utf8": "If you don't use the Gemini stuff so much,\nyou can still get just as much computer"
    } ]
  }, {
    "tStartMs": 720189,
    "dDurationMs": 1547,
    "segs": [ {
      "utf8": "for less with a Chromebook, but..."
    } ]
  }, {
    "tStartMs": 721818,
    "dDurationMs": 1115,
    "segs": [ {
      "utf8": "I find that stuff useful."
    } ]
  }, {
    "tStartMs": 723685,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Then: photographers."
    } ]
  }, {
    "tStartMs": 725203,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "I wanted to write the whole word here,\nbut it didn't fit."
    } ]
  }, {
    "tStartMs": 728840,
    "dDurationMs": 1788,
    "segs": [ {
      "utf8": "B-.\nSo there's like Photoshop Express"
    } ]
  }, {
    "tStartMs": 731160,
    "dDurationMs": 1119,
    "segs": [ {
      "utf8": "and Lightroom for Android"
    } ]
  }, {
    "tStartMs": 732781,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and Snapseed, things like that.\nLike"
    } ]
  }, {
    "tStartMs": 735013,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "not really full-fledged editing suites,\nbut good enough for light retouching..."
    } ]
  }, {
    "tStartMs": 738807,
    "dDurationMs": 2464,
    "segs": [ {
      "utf8": "The display is bright enough,\nespecially on the ASUS,"
    } ]
  }, {
    "tStartMs": 741353,
    "dDurationMs": 831,
    "segs": [ {
      "utf8": "the 1,000-nit OLED."
    } ]
  }, {
    "tStartMs": 742266,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "Like, these are fine displays."
    } ]
  }, {
    "tStartMs": 743707,
    "dDurationMs": 1888,
    "segs": [ {
      "utf8": "They're not particularly great for color,"
    } ]
  }, {
    "tStartMs": 746207,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "but just for the casual edits,"
    } ]
  }, {
    "tStartMs": 748108,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "that's fine."
    } ]
  }, {
    "tStartMs": 749020,
    "dDurationMs": 3130,
    "segs": [ {
      "utf8": "The high-end stuff, you already know,\nyou're not looking at a Googlebook."
    } ]
  }, {
    "tStartMs": 753210,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Then: coders."
    } ]
  }, {
    "tStartMs": 754638,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Okay,"
    } ]
  }, {
    "tStartMs": 755682,
    "dDurationMs": 2465,
    "segs": [ {
      "utf8": "this turned out to be like sneaky\none of the things that I don't"
    } ]
  }, {
    "tStartMs": 758229,
    "dDurationMs": 1117,
    "segs": [ {
      "utf8": "have so much experience with,"
    } ]
  }, {
    "tStartMs": 759428,
    "dDurationMs": 2025,
    "segs": [ {
      "utf8": "but it turns out these\nmight actually be great for."
    } ]
  }, {
    "tStartMs": 761535,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Mostly because Google happens to\nhave a bunch of really robust agentic"
    } ]
  }, {
    "tStartMs": 764387,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "coding tools like Android Studio"
    } ]
  }, {
    "tStartMs": 766281,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "that work really well on these\nmachines so long as you give"
    } ]
  }, {
    "tStartMs": 768686,
    "dDurationMs": 1018,
    "segs": [ {
      "utf8": "them an internet connection"
    } ]
  }, {
    "tStartMs": 770446,
    "dDurationMs": 896,
    "segs": [ {
      "utf8": "and enough local memory."
    } ]
  }, {
    "tStartMs": 772094,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "And they did give them\nenough local memory,"
    } ]
  }, {
    "tStartMs": 773846,
    "dDurationMs": 2614,
    "segs": [ {
      "utf8": "so that's good news.\nThen: video editors."
    } ]
  }, {
    "tStartMs": 777420,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Okay, so"
    } ]
  }, {
    "tStartMs": 778611,
    "dDurationMs": 1179,
    "segs": [ {
      "utf8": "no Premiere Pro,"
    } ]
  }, {
    "tStartMs": 780452,
    "dDurationMs": 2327,
    "segs": [ {
      "utf8": "no Final Cut Pro,\nno"
    } ]
  }, {
    "tStartMs": 783531,
    "dDurationMs": 1055,
    "segs": [ {
      "utf8": "Resolve, but"
    } ]
  }, {
    "tStartMs": 785308,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "you do have"
    } ]
  }, {
    "tStartMs": 786930,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "CapCut"
    } ]
  }, {
    "tStartMs": 788039,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "and LumaFusion."
    } ]
  }, {
    "tStartMs": 789461,
    "dDurationMs": 1136,
    "segs": [ {
      "utf8": "You know, I mentioned earlier,"
    } ]
  }, {
    "tStartMs": 790679,
    "dDurationMs": 2312,
    "segs": [ {
      "utf8": "you can drag and drop files\nfrom your phone back and forth,"
    } ]
  }, {
    "tStartMs": 793073,
    "dDurationMs": 1217,
    "segs": [ {
      "utf8": "from the computer to your phone,"
    } ]
  }, {
    "tStartMs": 794902,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and that's cool,"
    } ]
  }, {
    "tStartMs": 795814,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "but it's only for files\nup to 200 megabytes,"
    } ]
  }, {
    "tStartMs": 797337,
    "dDurationMs": 2353,
    "segs": [ {
      "utf8": "which does kind of rule out a\nlot of the bigger video files."
    } ]
  }, {
    "tStartMs": 800442,
    "dDurationMs": 1988,
    "segs": [ {
      "utf8": "I don't think people who are\ntrying to get a laptop"
    } ]
  }, {
    "tStartMs": 802512,
    "dDurationMs": 1136,
    "segs": [ {
      "utf8": "specifically for video editing"
    } ]
  }, {
    "tStartMs": 804390,
    "dDurationMs": 4782,
    "segs": [ {
      "utf8": "are looking at getting a Googlebook.\nGamers..."
    } ]
  }, {
    "tStartMs": 809254,
    "dDurationMs": 1925,
    "segs": [ {
      "utf8": "I don't know if you even"
    } ]
  }, {
    "tStartMs": 811841,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "made it this far into the video, but"
    } ]
  }, {
    "tStartMs": 815920,
    "dDurationMs": 915,
    "segs": [ {
      "utf8": "thanks for watching."
    } ]
  }, {
    "tStartMs": 817657,
    "dDurationMs": 1552,
    "segs": [ {
      "utf8": "And then: Grandma.\nOkay, great."
    } ]
  }, {
    "tStartMs": 819291,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Yeah, so I"
    } ]
  }, {
    "tStartMs": 820388,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "don't think you're\ngonna need one of these."
    } ]
  }, {
    "tStartMs": 822181,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "I know, Grandma, I know you like to shop."
    } ]
  }, {
    "tStartMs": 824470,
    "dDurationMs": 1169,
    "segs": [ {
      "utf8": "I know you like to web browse."
    } ]
  }, {
    "tStartMs": 825721,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "I know you like to email\nall of the grandkids,"
    } ]
  }, {
    "tStartMs": 828108,
    "dDurationMs": 877,
    "segs": [ {
      "utf8": "and that's really cool."
    } ]
  }, {
    "tStartMs": 829507,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "But I feel like for $1,000,\nwe can get you a better computer for less."
    } ]
  }, {
    "tStartMs": 832965,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "We can do more with $1,000.\nEither way,"
    } ]
  }, {
    "tStartMs": 836526,
    "dDurationMs": 977,
    "segs": [ {
      "utf8": "I think that's about it."
    } ]
  }, {
    "tStartMs": 837585,
    "dDurationMs": 1242,
    "segs": [ {
      "utf8": "Hopefully that was helpful.\nUh,"
    } ]
  }, {
    "tStartMs": 838909,
    "dDurationMs": 3315,
    "segs": [ {
      "utf8": "I do enjoy reviewing these things when\nthey're new first-generation products,"
    } ]
  }, {
    "tStartMs": 842306,
    "dDurationMs": 974,
    "segs": [ {
      "utf8": "but a lot more to come."
    } ]
  }, {
    "tStartMs": 844050,
    "dDurationMs": 1021,
    "segs": [ {
      "utf8": "Thanks for watching!"
    } ]
  }, {
    "tStartMs": 845153,
    "dDurationMs": 2029,
    "segs": [ {
      "utf8": "Catch you guys in the next one...\nPeace."
