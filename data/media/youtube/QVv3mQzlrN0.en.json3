  }, {
    "tStartMs": 241560,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "thing."
    } ]
  }, {
    "tStartMs": 242604,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "It does support"
    } ]
  }, {
    "tStartMs": 243648,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "the CarPlay standard.\nSo"
    } ]
  }, {
    "tStartMs": 244692,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "apps that"
    } ]
  }, {
    "tStartMs": 245736,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "use the CarPlay standard,\nyou'll be able to"
    } ]
  }, {
    "tStartMs": 247260,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "beam"
    } ]
  }, {
    "tStartMs": 248304,
    "dDurationMs": 1153,
    "segs": [ {
      "utf8": "content from your...\niPhone to this display."
    } ]
  }, {
    "tStartMs": 249539,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "We'll get more into that in a second, but"
    } ]
  }, {
    "tStartMs": 251853,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "yeah, no"
    } ]
  }, {
    "tStartMs": 252897,
    "dDurationMs": 2352,
    "segs": [ {
      "utf8": "third-party apps.\nBut then this big headlining feature"
    } ]
  }, {
    "tStartMs": 255751,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "is"
    } ]
  }, {
    "tStartMs": 256795,
    "dDurationMs": 2097,
    "segs": [ {
      "utf8": "fast account switching.\nThis is actually pretty clever."
    } ]
  }, {
    "tStartMs": 259020,
    "dDurationMs": 2272,
    "segs": [ {
      "utf8": "So up at the top here,\nit's kind of hard to see,"
    } ]
  }, {
    "tStartMs": 261374,
    "dDurationMs": 1411,
    "segs": [ {
      "utf8": "but there is a single camera..."
    } ]
  }, {
    "tStartMs": 262867,
    "dDurationMs": 1412,
    "segs": [ {
      "utf8": "that does facial recognition..."
    } ]
  }, {
    "tStartMs": 264361,
    "dDurationMs": 2567,
    "segs": [ {
      "utf8": "So when you walk up to the HomeView,\nit recognizes you,"
    } ]
  }, {
    "tStartMs": 267010,
    "dDurationMs": 1749,
    "segs": [ {
      "utf8": "and then it's able to give you answers"
    } ]
  }, {
    "tStartMs": 269261,
    "dDurationMs": 1219,
    "segs": [ {
      "utf8": "from your personal context,"
    } ]
  }, {
    "tStartMs": 270682,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "like your messages"
    } ]
  }, {
    "tStartMs": 272079,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and your calendar,"
    } ]
  }, {
    "tStartMs": 273123,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "et cetera.\nSo if nobody's walked up to it or"
    } ]
  }, {
    "tStartMs": 275093,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "nobody that it recognizes walks up to it,\nit still works."
    } ]
  }, {
    "tStartMs": 277553,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "It just doesn't give that\npersonal information..."
    } ]
  }, {
    "tStartMs": 279669,
    "dDurationMs": 1947,
    "segs": [ {
      "utf8": "And you can choose...\nwhich information that is."
    } ]
  }, {
    "tStartMs": 282198,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "But it can always do...\ntimers"
