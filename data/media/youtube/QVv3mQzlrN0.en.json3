  }, {
    "tStartMs": 283570,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and..."
    } ]
  }, {
    "tStartMs": 284482,
    "dDurationMs": 2330,
    "segs": [ {
      "utf8": "ask Siri stuff and say the weather\nand play music and things like that."
    } ]
  }, {
    "tStartMs": 286894,
    "dDurationMs": 1403,
    "segs": [ {
      "utf8": "So for multi-person households,"
    } ]
  }, {
    "tStartMs": 288969,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "it will,"
    } ]
  }, {
    "tStartMs": 290013,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "based on who"
    } ]
  }, {
    "tStartMs": 291057,
    "dDurationMs": 1512,
    "segs": [ {
      "utf8": "walks up to it and who it recognizes,\nit will"
    } ]
  }, {
    "tStartMs": 292771,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "actively switch between"
    } ]
  }, {
    "tStartMs": 293993,
    "dDurationMs": 1498,
    "segs": [ {
      "utf8": "different...\npersonal contexts and"
    } ]
  }, {
    "tStartMs": 295693,
    "dDurationMs": 1738,
    "segs": [ {
      "utf8": "different Apple accounts...\nseamlessly."
    } ]
  }, {
    "tStartMs": 297513,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "Whoever walks up to it, boom,\nswitches to the new person's account."
    } ]
  }, {
    "tStartMs": 301768,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Which, to be clear,"
    } ]
  }, {
    "tStartMs": 303149,
    "dDurationMs": 1269,
    "segs": [ {
      "utf8": "they've never done this before..."
    } ]
  }, {
    "tStartMs": 304500,
    "dDurationMs": 1884,
    "segs": [ {
      "utf8": "We've wanted them to do this before...\nbecause..."
    } ]
  }, {
    "tStartMs": 306466,
    "dDurationMs": 1187,
    "segs": [ {
      "utf8": "I've wanted this on...\niPads for"
    } ]
  }, {
    "tStartMs": 307855,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "years...\nand"
    } ]
  }, {
    "tStartMs": 308899,
    "dDurationMs": 1076,
    "segs": [ {
      "utf8": "Apple would rather just...\nyou buy"
    } ]
  }, {
    "tStartMs": 310647,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "more...\niPads for more people in your family,"
    } ]
  }, {
    "tStartMs": 312449,
    "dDurationMs": 2579,
    "segs": [ {
      "utf8": "but this has to live in a household\nwhere multiple people use it."
    } ]
  }, {
    "tStartMs": 315640,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So"
    } ]
  }, {
    "tStartMs": 316684,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "fast account switching"
    } ]
  }, {
    "tStartMs": 317728,
    "dDurationMs": 2052,
    "segs": [ {
      "utf8": "is the clever thing.\nAnd this will work for up to six people."
    } ]
  }, {
    "tStartMs": 320690,
    "dDurationMs": 925,
    "segs": [ {
      "utf8": "Two things though."
    } ]
  }, {
    "tStartMs": 322337,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "One,"
    } ]
  }, {
    "tStartMs": 323381,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "this is not"
    } ]
  }, {
    "tStartMs": 324425,
    "dDurationMs": 2673,
    "segs": [ {
      "utf8": "full Face ID...\nSo just to be clear, it is just the single"
    } ]
  }, {
    "tStartMs": 327300,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "12-megapixel Center Stage camera"
    } ]
  }, {
    "tStartMs": 329447,
    "dDurationMs": 938,
    "segs": [ {
      "utf8": "and then...\nno extra"
    } ]
  }, {
    "tStartMs": 330997,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "IR"
    } ]
  }, {
    "tStartMs": 332041,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "or depth information.\nBut it also"
    } ]
  }, {
    "tStartMs": 333443,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "pays attention to"
    } ]
  }, {
    "tStartMs": 334487,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "if your"
    } ]
  }, {
    "tStartMs": 335531,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "iPhone"
    } ]
  }, {
    "tStartMs": 336575,
    "dDurationMs": 128,
    "segs": [ {
      "utf8": "or"
    } ]
  }, {
    "tStartMs": 336703,
    "dDurationMs": 916,
    "segs": [ {
      "utf8": "Watch...\nis"
    } ]
  }, {
    "tStartMs": 337833,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "nearby"
    } ]
  }, {
    "tStartMs": 338784,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and was recently unlocked...\njust to"
    } ]
  }, {
    "tStartMs": 339828,
    "dDurationMs": 866,
    "segs": [ {
      "utf8": "double-check to make sure it was you."
    } ]
  }, {
    "tStartMs": 340896,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So in"
    } ]
  }, {
    "tStartMs": 341940,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "theory,"
    } ]
  }, {
    "tStartMs": 342984,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "if someone like"
    } ]
  }, {
    "tStartMs": 344028,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "holds up a picture of you,"
    } ]
  }, {
    "tStartMs": 344940,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "but you're somewhere else or you're\nasleep and your phone is locked for"
    } ]
  }, {
    "tStartMs": 347252,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "a while or something like that,"
    } ]
  }, {
    "tStartMs": 349491,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "it should not"
    } ]
  }, {
    "tStartMs": 350535,
    "dDurationMs": 1415,
    "segs": [ {
      "utf8": "be tricked by that.\nBut I do wonder how"
    } ]
  }, {
    "tStartMs": 352152,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "good that is...\nand also how"
    } ]
  }, {
    "tStartMs": 353513,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "well it will recognize\npeople in the dark..."
    } ]
  }, {
    "tStartMs": 355536,
    "dDurationMs": 1952,
    "segs": [ {
      "utf8": "since there's no infrared.\nBut then number two,"
    } ]
  }, {
    "tStartMs": 358310,
    "dDurationMs": 884,
    "segs": [ {
      "utf8": "no...\nvoice recognition,"
    } ]
  }, {
    "tStartMs": 360096,
    "dDurationMs": 1303,
    "segs": [ {
      "utf8": "which I was kind of surprised by."
    } ]
  }, {
    "tStartMs": 361481,
    "dDurationMs": 1428,
    "segs": [ {
      "utf8": "I figured they could have done this."
    } ]
  }, {
    "tStartMs": 363111,
    "dDurationMs": 1849,
    "segs": [ {
      "utf8": "You know, with Google's,\nI have a Google Home,"
    } ]
  }, {
    "tStartMs": 365042,
    "dDurationMs": 1261,
    "segs": [ {
      "utf8": "the Nest Hub Max and everything,"
    } ]
  }, {
    "tStartMs": 366505,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "this"
    } ]
  }, {
    "tStartMs": 367549,
    "dDurationMs": 2022,
    "segs": [ {
      "utf8": "is how it's supposed to work.\nIt doesn't always work, but when"
    } ]
  }, {
    "tStartMs": 369773,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "I ask for something,"
    } ]
  }, {
    "tStartMs": 370817,
    "dDurationMs": 2771,
    "segs": [ {
      "utf8": "it knows my voice, recognizes me,\nand so it gives me personal answers."
    } ]
  }, {
    "tStartMs": 373670,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "If someone else"
    } ]
  }, {
    "tStartMs": 374714,
    "dDurationMs": 2686,
    "segs": [ {
      "utf8": "has a different account on it,\nit will give them their personal answers,"
    } ]
  }, {
    "tStartMs": 378280,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "but..."
    } ]
  }, {
    "tStartMs": 379192,
    "dDurationMs": 1574,
    "segs": [ {
      "utf8": "that's not how the\nApple version will work."
    } ]
  }, {
    "tStartMs": 380848,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "HomeView..."
    } ]
  }, {
    "tStartMs": 381760,
    "dDurationMs": 1927,
    "segs": [ {
      "utf8": "can only do that personal\ncontext if it sees you"
    } ]
  }, {
    "tStartMs": 384229,
    "dDurationMs": 1107,
    "segs": [ {
      "utf8": "in the general vicinity,"
    } ]
  }, {
    "tStartMs": 385418,
    "dDurationMs": 2295,
    "segs": [ {
      "utf8": "not if you're around the\ncorner or on the couch."
    } ]
  }, {
    "tStartMs": 387795,
    "dDurationMs": 1666,
    "segs": [ {
      "utf8": "Now, a couple other things I noticed..."
    } ]
  }, {
    "tStartMs": 389543,
    "dDurationMs": 1846,
    "segs": [ {
      "utf8": "There's no battery in here.\nSo while you can"
