    "segs": [ {
      "utf8": "in that base"
    } ]
  }, {
    "tStartMs": 149043,
    "dDurationMs": 999,
    "segs": [ {
      "utf8": "to give you the fuller sound."
    } ]
  }, {
    "tStartMs": 150124,
    "dDurationMs": 2314,
    "segs": [ {
      "utf8": "So of course the wall-mounted version,\nsince it doesn't have..."
