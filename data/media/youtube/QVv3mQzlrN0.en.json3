    "segs": [ {
      "utf8": "touchscreen"
    } ]
  }, {
    "tStartMs": 76884,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "sitting in this"
    } ]
  }, {
    "tStartMs": 77928,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "color-matching base."
    } ]
  }, {
    "tStartMs": 78972,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "It has speakers in it"
    } ]
  }, {
    "tStartMs": 80016,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and a camera at the top,"
    } ]
  }, {
    "tStartMs": 81183,
    "dDurationMs": 2428,
    "segs": [ {
      "utf8": "and the display articulates\nup and down a little bit"
