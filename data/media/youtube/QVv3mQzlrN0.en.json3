  }, {
    "tStartMs": 232919,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "So it's"
    } ]
  }, {
    "tStartMs": 233963,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "kind of like"
    } ]
  }, {
    "tStartMs": 235007,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "an"
    } ]
  }, {
    "tStartMs": 236051,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "iPhone"
    } ]
  }, {
    "tStartMs": 237095,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "home screen."
    } ]
  }, {
    "tStartMs": 238139,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "But to be perfectly clear,"
    } ]
  }, {
    "tStartMs": 239183,
    "dDurationMs": 106,
    "segs": [ {
      "utf8": "no"
    } ]
  }, {
    "tStartMs": 239289,
    "dDurationMs": 938,
    "segs": [ {
      "utf8": "App Store.\nNo..."
    } ]
  }, {
    "tStartMs": 240309,
    "dDurationMs": 1049,
    "segs": [ {
      "utf8": "App Store,\nno third-party apps will run on this"
