    "dDurationMs": 830,
    "segs": [ {
      "utf8": "it sounds worse"
    } ]
  }, {
    "tStartMs": 180482,
    "dDurationMs": 1108,
    "segs": [ {
      "utf8": "'cause there's no woofer."
