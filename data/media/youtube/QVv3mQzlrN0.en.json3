  "events": [ {
    "tStartMs": 2432,
    "dDurationMs": 2396,
    "segs": [ {
      "utf8": "All right, so Apple had a mini\nHome event today..."
    } ]
  }, {
    "tStartMs": 4910,
    "dDurationMs": 2075,
    "segs": [ {
      "utf8": "where they refreshed\ntheir Home lineup with..."
    } ]
  }, {
    "tStartMs": 7067,
    "dDurationMs": 902,
    "segs": [ {
      "utf8": "a new HomePod mini 2,"
    } ]
  }, {
    "tStartMs": 8051,
    "dDurationMs": 3059,
    "segs": [ {
      "utf8": "which has some new colors and a\nnew glowing display at the top that"
    } ]
  }, {
    "tStartMs": 11192,
    "dDurationMs": 1371,
    "segs": [ {
      "utf8": "matches your music's album art,"
    } ]
  }, {
    "tStartMs": 12765,
    "dDurationMs": 855,
    "segs": [ {
      "utf8": "a new Apple TV 4K..."
    } ]
  }, {
    "tStartMs": 13702,
    "dDurationMs": 996,
    "segs": [ {
      "utf8": "that has far-field mics"
    } ]
  }, {
    "tStartMs": 14900,
    "dDurationMs": 3153,
    "segs": [ {
      "utf8": "and a new remote with speakers so\nyou can always ask Siri to find it,"
    } ]
  }, {
    "tStartMs": 18255,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "clever,"
    } ]
  }, {
    "tStartMs": 19303,
    "dDurationMs": 2027,
    "segs": [ {
      "utf8": "and a new device to tie\nthe Home all together"
    } ]
  }, {
    "tStartMs": 21962,
    "dDurationMs": 856,
    "segs": [ {
      "utf8": "called...\nHomeView..."
    } ]
  }, {
    "tStartMs": 22900,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "They just, they never name it..."
    } ]
  }, {
    "tStartMs": 24400,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "what you think they're gonna name it.\nBut yeah,"
    } ]
  }, {
    "tStartMs": 26552,
    "dDurationMs": 2325,
    "segs": [ {
      "utf8": "this was a real hole in\ntheir ecosystem for a while,"
    } ]
  }, {
    "tStartMs": 28959,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "and if Apple wants to pull people from...\nthe Amazon"
    } ]
  }, {
    "tStartMs": 31910,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and"
    } ]
  }, {
    "tStartMs": 32954,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Google"
    } ]
  }, {
    "tStartMs": 33998,
    "dDurationMs": 1152,
    "segs": [ {
      "utf8": "Home ecosystems...\nthey needed something like this."
    } ]
  }, {
    "tStartMs": 35470,
    "dDurationMs": 1637,
    "segs": [ {
      "utf8": "Now that I've spent some\ntime with it though,"
    } ]
  }, {
    "tStartMs": 37309,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "and I've digested everything,"
    } ]
  }, {
    "tStartMs": 39270,
    "dDurationMs": 1548,
    "segs": [ {
      "utf8": "I actually don't think this"
    } ]
  }, {
    "tStartMs": 41020,
    "dDurationMs": 1037,
    "segs": [ {
      "utf8": "first...\noffering..."
    } ]
  }, {
    "tStartMs": 42139,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "is"
    } ]
  }, {
    "tStartMs": 43183,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "very convincing.\nSo welcome to your hands-on..."
    } ]
  }, {
    "tStartMs": 44708,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and first look"
    } ]
  }, {
    "tStartMs": 45857,
    "dDurationMs": 2373,
    "segs": [ {
      "utf8": "and everything you need to\nknow or might be wondering"
    } ]
  }, {
    "tStartMs": 48742,
    "dDurationMs": 891,
    "segs": [ {
      "utf8": "about this...\nApple..."
    } ]
  }, {
    "tStartMs": 49715,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "HomeView."
    } ]
  }, {
    "tStartMs": 50759,
    "dDurationMs": 3166,
    "segs": [ {
      "utf8": "And I'm gonna try to make it quick\n'cause I just have a few key thoughts..."
    } ]
  }, {
    "tStartMs": 54007,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "on this thing."
    } ]
  }, {
    "tStartMs": 55336,
    "dDurationMs": 983,
    "segs": [ {
      "utf8": "So the basic product..."
    } ]
  }, {
    "tStartMs": 56401,
    "dDurationMs": 984,
    "segs": [ {
      "utf8": "is this is a display..."
    } ]
  }, {
    "tStartMs": 57467,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "that lives somewhere in your\nhouse as a dashboard or a hub..."
    } ]
  }, {
    "tStartMs": 60293,
    "dDurationMs": 845,
    "segs": [ {
      "utf8": "for your smart home."
    } ]
  }, {
    "tStartMs": 61340,
    "dDurationMs": 2559,
    "segs": [ {
      "utf8": "Kind of the equivalent of like\nthe Google Nest Hub Max..."
    } ]
  }, {
    "tStartMs": 63981,
    "dDurationMs": 1076,
    "segs": [ {
      "utf8": "or the Amazon Echo Hub..."
    } ]
  }, {
    "tStartMs": 65139,
    "dDurationMs": 2605,
    "segs": [ {
      "utf8": "So it serves as a controller or\na connector for all of the"
    } ]
  }, {
    "tStartMs": 67826,
    "dDurationMs": 1354,
    "segs": [ {
      "utf8": "other pieces of your smart home"
