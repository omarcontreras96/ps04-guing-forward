    "dDurationMs": 898,
    "segs": [ {
      "utf8": "Power over Ethernet adapter."
    } ]
  }, {
    "tStartMs": 172613,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "So if I'm getting this straight,\nthe wall-mounted version..."
    } ]
  }, {
    "tStartMs": 174828,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "doesn't come with the adapter to\nactually attach it to the wall."
    } ]
  }, {
    "tStartMs": 177190,
    "dDurationMs": 2248,
    "segs": [ {
      "utf8": "You have to buy that separately.\nAnd..."
