    "segs": [ {
      "utf8": "on this little"
    } ]
  }, {
    "tStartMs": 84857,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "arm...\nand it's mostly made of metal."
    } ]
  }, {
    "tStartMs": 86346,
    "dDurationMs": 2138,
