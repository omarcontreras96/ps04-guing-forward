  }, {
    "tStartMs": 434145,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "pretty decent..."
    } ]
  }, {
    "tStartMs": 435057,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "no matter what you think\nof the rest of the design."
    } ]
  }, {
    "tStartMs": 437800,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "I think it looks"
    } ]
  }, {
    "tStartMs": 439122,
    "dDurationMs": 1608,
    "segs": [ {
      "utf8": "a little funky, but whatever.\nBut..."
    } ]
  }, {
    "tStartMs": 440812,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "the LCD display itself...\nlooks fine."
    } ]
  }, {
    "tStartMs": 442671,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It gets up to 500 nits."
    } ]
  }, {
    "tStartMs": 444443,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "I..."
    } ]
  }, {
    "tStartMs": 445355,
    "dDurationMs": 1545,
    "segs": [ {
      "utf8": "personally can't tell if\nit's higher refresh rate."
    } ]
  }, {
    "tStartMs": 446982,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "I'm pretty sure it's 60Hz in the\nlittle time I interacted with it,"
    } ]
  }, {
    "tStartMs": 450725,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "but it goes...\ndown"
    } ]
  }, {
    "tStartMs": 451769,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "to 0.3 nits at its"
    } ]
  }, {
    "tStartMs": 452813,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "lowest,"
    } ]
  }, {
    "tStartMs": 453857,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "and it has True Tone."
    } ]
  }, {
    "tStartMs": 455115,
    "dDurationMs": 2222,
    "segs": [ {
      "utf8": "And that's actually really\nimportant in the dark."
    } ]
